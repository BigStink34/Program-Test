generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Player {
  id        Int      @id @default(autoincrement())
  name      String
  class     String
  hp        Int      @default(100)
  attack    Int      @default(10)
  defense   Int      @default(5)
  mana      Int      @default(50)
  createdAt DateTime @default(now())
}

model Enemy {
  id      Int    @id @default(autoincrement())
  name    String
  hp      Int
  attack  Int
  defense Int
  reward  Int
}
